<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/ArticleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/second_article_title" />

            <TextView
                style="@style/ArticleDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/second_article_date" />

            <CheckBox
                android:id="@+id/checkboxRead"
                style="@style/ArticleControl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/article_read" />

            <ImageView
                android:id="@+id/imageViewArticle"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:background="#E0E0E0"
                android:contentDescription="@string/article_image_description"
                android:scaleType="centerCrop" />

            <TextView
                style="@style/ArticleBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/second_article_intro" />

            <TextView
                style="@style/ArticleBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/second_article_details" />

            <TextView
                style="@style/ArticleBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/second_article_terms" />

            <TextView
                style="@style/ArticleBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/second_article_approval" />

            <TextView
                style="@style/ArticleSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/second_article_history_title" />

            <TextView
                style="@style/ArticleQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/second_article_history_quote" />

            <TextView
                style="@style/ArticleQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/second_article_history_ownership" />

            <TextView
                style="@style/ArticleQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/second_article_history_shares" />

            <Button
                android:id="@+id/btn_back"
                style="@style/ArticleControl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="8dp"
                android:text="@string/back_to_previous_article"
                android:textAlignment="center" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
